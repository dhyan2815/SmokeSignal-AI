# 🔥 SmokeSignal-AI Email Configuration
# Copy this file and replace the example values with your actual credentials

# Gmail account for sending alerts (REQUIRED)
# Replace with your actual Gmail address
EMAIL_ADDRESS=dhyan2192004@gmail.com

# Gmail App Password (REQUIRED)
# This is NOT your regular Gmail password
# To get an App Password:
# 1. Go to your Google Account settings (https://myaccount.google.com/)
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to Security > App passwords
# 4. Select "Mail" and generate a new app password
# 5. Copy the 16-character password (no spaces) below
EMAIL_PASSWORD=pegb oukv jfgj kxcu

# Target email for receiving alerts (OPTIONAL)
# Replace with the email address where you want to receive wildfire alerts
TARGET_EMAIL=dhyan.work.2815@gmail.com

# Example configurations:
# EMAIL_ADDRESS=john.doe@gmail.com
# EMAIL_PASSWORD=abcd efgh ijkl mnop
# TARGET_EMAIL=emergency@company.com

# Security Notes:
# - Never commit this .env file to version control
# - Keep your app password secure
# - Use different app passwords for different applications
# - The app password shown above is just an example - generate your own! 